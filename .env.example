VITE_OKTA_ISSUER=https://your-okta-domain/oauth2/your-auth-server-id
VITE_OKTA_CLIENT_ID=your-client-id
# Space-separated scopes. Defaults to "openid profile email" if unset.
VITE_OKTA_SCOPES=
# Comma-separated list of claim:Heading pairs to display on the profile page.
VITE_OKTA_PROFILE_CLAIMS=
# The Enrolled Factors button requests a separate token from VITE_OKTA_ISSUER
# with the okta.myAccount.authenticators.read scope.
# Enroll Passkey button (hidden unless the client ID is set). Uses the
# prompt=enroll_authenticator flow against the org /oauth2/v1/authorize endpoint.
VITE_OKTA_ENROLL_CLIENT_ID=
# Space-separated authenticator AMR values to enroll. Defaults to "webauthn".
VITE_OKTA_ENROLL_AMR_VALUES=
# Must be a sign-in redirect URI registered on the enroll app. Defaults to <origin>/profile.
VITE_OKTA_ENROLL_REDIRECT_URI=
